[{{ r2_remote_name }}]
type = s3
provider = Cloudflare
access_key_id = {{ vault_r2_access_key_id }}
secret_access_key = {{ vault_r2_secret_access_key }}
endpoint = {{ vault_r2_endpoint }}
no_check_bucket = true

[photos-src]
type = s3
provider = Cloudflare
access_key_id = {{ vault_photos_src_access_key_id }}
secret_access_key = {{ vault_photos_src_secret_access_key }}
endpoint = {{ vault_r2_endpoint }}
no_check_bucket = true

[photos-dst]
type = s3
provider = Cloudflare
access_key_id = {{ vault_photos_dst_access_key_id }}
secret_access_key = {{ vault_photos_dst_secret_access_key }}
endpoint = {{ vault_r2_endpoint }}
no_check_bucket = true